          "name": "Litmus Create an email preview",
          "request": {
            "name": "Litmus Create an email preview",
            "description": {
              "content": "Submits email HTML to generate previews across one or more email clients. The request body includes the HTML source and a list of email client identifiers. Returns a preview object with a unique ID that can be used to retrieve individual client screenshots once rendering is complete.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "emails"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"html\": \"<string>\",\n  \"clients\": [\n    \"<string>\"\n  ],\n  \"plain_text\": \"<string>\",\n  \"subject\": \"<string>\",\n  \"from_address\": \"<email>\"\n}",
